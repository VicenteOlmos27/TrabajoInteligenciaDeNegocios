                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    CAST(ClienteID AS NVARCHAR(10)) AS ClienteID,
    CAST(Empresa AS NVARCHAR(100)) AS Empresa,
    CAST(Ciudad AS NVARCHAR(50)) AS Ciudad,
    CAST(Pais AS NVARCHAR(50)) AS Pais
FROM dbo.Clientes;</property>
