    CAST(FechaOrden AS DATE) AS Fecha,
    YEAR(FechaOrden) AS Anio,
    MONTH(FechaOrden) AS Mes,
    CAST(DATENAME(MONTH, FechaOrden) AS NVARCHAR(20)) AS NombreMes
FROM dbo.Ordenes
WHERE FechaOrden IS NOT NULL;</property>
