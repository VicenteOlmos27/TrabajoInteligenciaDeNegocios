                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    o.OrdenID,
    CONVERT(INT, CONVERT(VARCHAR(8), ISNULL(o.FechaOrden, GETDATE()), 112)) AS TiempoID,
    o.ClienteID,
    o.EmpleadoID,
    ISNULL(o.EnviadoPor, 1) AS TransportistaID,
    d.ProductoID,
    d.PrecioUnitario,
    d.Cantidad,
    d.Descuento
FROM dbo.Ordenes o
INNER JOIN dbo.DetalleOrden d ON o.OrdenID = d.OrdenID;</property>
